# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local secrets (API keys/tokens shared as text files) - never commit
secrets/
*.secret.txt
*token*.txt
*key*.txt
.env
.env.*
blastradius/test/replay/out/

# Recorded test fixtures are gzipped on purpose (offline tests read them)
!blastradius/test/fixtures/sources/*.json.gz
