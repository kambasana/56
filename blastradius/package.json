{
  "name": "blastradius",
  "version": "0.1.0",
  "description": "Supply-chain blast-radius auditor (npm MVP)",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "blastradius": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx src/cli.ts",
    "hammer": "npm run build && tsx test/hammer/run.ts",
    "hammer:quick": "npm run build && tsx test/hammer/run.ts --skip-scale",
    "pack:build": "tsx src/pack/main.ts",
    "proof": "tsx test/replay/proof.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@octokit/app": "16.1.4",
    "@octokit/core": "7.0.8",
    "@octokit/webhooks": "14.2.0",
    "commander": "^15.0.0",
    "hono": "4.13.13",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@octokit/openapi": "23.0.2",
    "@octokit/webhooks-examples": "7.6.1",
    "@types/node": "^26.6.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
